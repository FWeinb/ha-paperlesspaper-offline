{
  "domain": "paperlessoffline",
  "name": "paperlesspaper (offline firmware)",
  "after_dependencies": [
    "bluetooth",
    "camera",
    "frontend",
    "image",
    "panel_custom"
  ],
  "bluetooth": [
    {
      "local_name": "epd*",
      "connectable": true
    }
  ],
  "codeowners": [
    "@fweinb"
  ],
  "config_flow": true,
  "dependencies": [
    "http",
    "media_source",
    "websocket_api"
  ],
  "documentation": "https://github.com/FWeinb/ha-paperlesspaper-offline",
  "integration_type": "device",
  "iot_class": "local_push",
  "issue_tracker": "https://github.com/FWeinb/ha-paperlesspaper-offline/issues",
  "loggers": [
    "paperlessoffline"
  ],
  "requirements": [
    "pillow-heif>=0.18.0"
  ],
  "version": "0.4.0"
}
